%[text] # Exercise 2 Solution: Build Pump-Fleet Detectors with the App
%[text] This solution prepares labeled app data, loads detector checkpoints, and verifies compatibility with one detection run.
workshopRoot = fileparts(which("setupWorkshop"));
moduleFolder = fullfile(workshopRoot,"02-PumpFleetAnomalyDetector");
addpath(fullfile(moduleFolder,"HelperFiles"))
load(fullfile(moduleFolder,"Data","pumpFleetData.mat"))
disp("Loaded " + numel(assetNames) + " pump assets.") %[output:9408e09f]
disp("Selected test assets: " + strjoin(string(selectedTestAssets),", ")) %[output:6ec3eff1]
sampleTime = minutes(0:size(trainData{1},1)-1)';
trainData = cellfun(@(x) array2timetable(x,RowTimes=sampleTime,VariableNames=channelNames),trainData,UniformOutput=false);
testData = cellfun(@(x) array2timetable(x,RowTimes=sampleTime,VariableNames=channelNames),testData,UniformOutput=false);
clear channelNames
%%
%[text] ## Explore Labeled Test Anomalies
plotPumpTestOverview(testData{1},testLabels{1},string(selectedTestAssets{1}),[1 2 4 6]) %[output:255f3120]
%%
%[text] ## Prepare App Test Data
testDataLabeled = prepareLabeledTestData(testData,testLabels);
disp("First labeled test member size:") %[output:24f0760a]
size(testDataLabeled{1}) %[output:9c8b0b71]
%%
%[text] ## App Workflow
app = timeSeriesAnomalyDetector;
importPumpFleetDataIntoApp(app,trainData,testDataLabeled) %[output:7b08cb1b]
%%
%[text] ## Using the app
%[text] Click on the training data to plot it. 
%[text] ![](text:image:7d67)
%[text] 
%[text] Train the DeepAnT, UsAD, and Isolation Forest detectors. 
%[text] ![](text:image:433d)
%[text] 
%[text] Click "Train All" to train all selected detectors.
%[text] ![](text:image:5941)
%[text] ![](text:image:216e)
%[text] 
%[text] Detect anomalies with the selected detector using the labeled test dataset.
%[text] ![](text:image:6319)
%[text] 
%[text] Compare multiple trained detectors
%[text] ![](text:image:428d)
%%
%[text] ## Optional: Load Detector Checkpoint
%[text] The remaining sections are an optional programmatic validation of a few trained detectors. 
load(fullfile(moduleFolder,"Checkpoints","trainedPumpDetectors.mat"))
detectors = {detectorUsAD, detectorDeepAnt, detectorIForest};
detectorNames = ["usAD","deepantAD","iforest"];
disp("Loaded detector checkpoint:") %[output:01124974]
disp(detectorNames) %[output:1362d471]
%%
%[text] ## Quick Validation
result = detect(detectorIForest,testData{1},Resolution="sample");
metrics = timeSeriesAnomalyMetrics(result.Labels,logical(testLabels{1}),Method="point-adjusted");
metrics.F1Score %[output:0ac6bc83]
%%
%[text] ## Train Programmatic Detector Candidates
%[text] The app is useful for interactive design, but the same workflow can be scripted. Train a few lightweight machine-learning detectors, evaluate them on the labeled test assets, and keep the best model by mean point-adjusted F1 score.
numChannels = width(trainData{1});
rng(0,"twister")
modelSpecs = [
    struct(Name="IForest",Factory=@() timeSeriesIforestAD(numChannels,WindowLength=120,TrainingStride=120,NumLearners=75,ThresholdMethod="kSigma",ThresholdParameter=3))
    struct(Name="LOF",Factory=@() timeSeriesLofAD(numChannels,WindowLength=120,TrainingStride=120,NumNeighbors=10,ThresholdMethod="kSigma",ThresholdParameter=3))
    struct(Name="OCSVM",Factory=@() timeSeriesOcsvmAD(numChannels,WindowLength=120,TrainingStride=120,ThresholdMethod="kSigma",ThresholdParameter=3))
];

nModels = numel(modelSpecs);
programmaticDetectors = cell(nModels,1);
programmaticResults = table(strings(nModels,1),zeros(nModels,1),zeros(nModels,1),zeros(nModels,1),cell(nModels,1), ...
    VariableNames=["Model","MeanF1","BestAssetF1","BestAssetIndex","PerAssetF1"]);
precisionWarningState = warning("off","predmaint_anomaly:anomaly:warnPrecisionSetToZero");
for m = 1:nModels %[output:group:28738b49]
    tic
    detector = modelSpecs(m).Factory();
    detector = train(detector,trainData);
    trainSeconds = toc;

    f1 = zeros(numel(testData),1);
    for k = 1:numel(testData)
        detectionResult = detect(detector,testData{k},Resolution="sample");
        modelMetrics = timeSeriesAnomalyMetrics(detectionResult.Labels,logical(testLabels{k}),Method="point-adjusted");
        f1(k) = modelMetrics.F1Score;
    end

    programmaticDetectors{m} = detector;
    programmaticResults.Model(m) = modelSpecs(m).Name;
    programmaticResults.MeanF1(m) = mean(f1,"omitnan");
    [programmaticResults.BestAssetF1(m),programmaticResults.BestAssetIndex(m)] = max(f1);
    programmaticResults.PerAssetF1{m} = f1;
    disp(modelSpecs(m).Name + " trained in " + trainSeconds + " seconds.") %[output:35123c0f]
end %[output:group:28738b49]
warning(precisionWarningState)
disp(programmaticResults) %[output:5463cc45]
%%
%[text] ## Plot Best Programmatic Detector
%[text] Use the best mean-F1 detector and plot selected sensor channels for the test asset where that detector performed best. Orange shading marks labeled anomalies. Red outlines mark predicted anomalies.
[~,bestModelIndex] = max(programmaticResults.MeanF1);
bestDetector = programmaticDetectors{bestModelIndex};
bestModelName = programmaticResults.Model(bestModelIndex);
bestAssetIndex = programmaticResults.BestAssetIndex(bestModelIndex);
bestDetectionResult = detect(bestDetector,testData{bestAssetIndex},Resolution="sample");
plotProgrammaticDetectorComparison(testData{bestAssetIndex},testLabels{bestAssetIndex},bestDetectionResult.Labels, ... %[output:group:491f5d64] %[output:7c2a40c0]
    string(selectedTestAssets{bestAssetIndex}),[1 2 4 6],bestModelName) %[output:group:491f5d64] %[output:7c2a40c0]
%%
%[text] ## App Parameters Used for the Checkpoint
%[text:table]
%[text] | Detector | Key Parameters |
%[text] | --- | --- |
%[text] | UsAD | `ObservationWindowLength = 120`, `TrainingStride = 120`, `LatentSpaceDim = 32` |
%[text] | DeepAnT | `ObservationWindowLength = 120`, `DetectionWindowLength = 10`, `NumFilters = 32` |
%[text] | Isolation Forest | `WindowLength = 120`, `TrainingStride = 120`, `NumLearners = 300` |
%[text:table]
function plotProgrammaticDetectorComparison(testDataAsset,actualLabels,predictedLabels,assetName,channelIdx,detectorName)

channelNames = string(testDataAsset.Properties.VariableNames(channelIdx));
actualRegions = localFindRegions(logical(actualLabels));
predictedRegions = localFindRegions(logical(predictedLabels));
tVec = 1:height(testDataAsset);

tiledlayout(numel(channelIdx),1,TileSpacing="compact",Padding="compact")
for k = 1:numel(channelIdx)
ax = nexttile;
sensorValues = testDataAsset{:,channelIdx(k)};
plot(tVec,sensorValues,Color=[0.12 0.28 0.52],LineWidth=0.9,DisplayName="Sensor")
hold on
yLimits = ylim;
localDrawRegions(actualRegions,yLimits,[0.95 0.55 0.18],0.22,"none",0.5,"Actual anomaly",k == 1)
localDrawRegions(predictedRegions,yLimits,"none",0,[0.85 0.05 0.05],1.3,"Predicted anomaly",k == 1)
plot(tVec,sensorValues,Color=[0.12 0.28 0.52],LineWidth=0.9,HandleVisibility="off")
ylabel(channelNames(k),Interpreter="none")
grid on
if k < numel(channelIdx)
ax.XTickLabel = [];
else
xlabel("Sample index (minutes)")
end
if k == 1
legend(Location="best")
end
end
sgtitle(assetName + " actual vs predicted anomalies: " + detectorName)
end

function importPumpFleetDataIntoApp(app,trainData,testDataLabeled)
%IMPORTPUMPFLEETDATAINTOAPP Load the prepared workshop data into the app.

labelName = "AnomalyLabel";
channelNames = string(trainData{1}.Properties.VariableNames(:));

testLabelsForApp = cellfun(@(tt) tt.(labelName),testDataLabeled,UniformOutput=false);
testDataForApp = cellfun(@(tt) removevars(tt,labelName),testDataLabeled,UniformOutput=false);

addAppDataset(app,"trainData",trainData,[],true,20,channelNames,"",0)
addAppDataset(app,"testDataLabeled",testDataForApp,testLabelsForApp,false,NaN,channelNames,labelName,width(testDataLabeled{1}))

disp("Loaded trainData and testDataLabeled into the Time Series Anomaly Detector app.")
end

function addAppDataset(app,datasetName,data,labels,isTrainingData,validationHoldout,channelNames,labelName,labelIndex)
unlabeledName = string(message("predmaint_anomaly:anomaly_app:strUnlabeled"));
if labelIndex == 0
    labelVariable = unlabeledName;
    normalClassLabel = string.empty;
    labelDataType = string.empty;
else
    labelVariable = labelName;
    normalClassLabel = "false";
    labelDataType = "logical";
end

metadata = struct( ...
    Name=datasetName, ...
    DataType="timetable", ...
    isTrainingData=isTrainingData, ...
    ValidationHoldoutPercentage=validationHoldout, ...
    ChannelNames=channelNames, ...
    ChannelIndex=(1:numel(channelNames))', ...
    LabelVariable=labelVariable, ...
    LabelIndex=labelIndex, ...
    OriginalNormalClassLabel=normalClassLabel, ...
    OriginalLabelDataType=labelDataType, ...
    Members=numel(data));

app.DataStore.addData(matlab.lang.internal.uuid,metadata,data,labels);
end

function localDrawRegions(regions,yLimits,faceColor,faceAlpha,edgeColor,lineWidth,displayName,showLegend)
for r = 1:size(regions,1)
xPatch = [regions(r,1) regions(r,2) regions(r,2) regions(r,1)];
yPatch = [yLimits(1) yLimits(1) yLimits(2) yLimits(2)];
if showLegend && r == 1
visibility = "on";
else
visibility = "off";
end
patch(XData=xPatch,YData=yPatch,FaceColor=faceColor,FaceAlpha=faceAlpha,EdgeColor=edgeColor, ...
LineWidth=lineWidth,DisplayName=displayName,HandleVisibility=visibility)
end
end

function regions = localFindRegions(binaryLabel)
d = diff([false; binaryLabel(:); false]);
starts = find(d == 1);
ends = find(d == -1) - 1;
regions = [starts, ends];
end
